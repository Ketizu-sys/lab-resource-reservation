# 复制为 .env 后再填写；.env 已被 Git 忽略，不能提交真实密码。
MYSQL_DATABASE=reservationdb
MYSQL_USER=azki
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
# 宿主机端口冲突时可修改；容器内服务端口保持不变。
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
APP_HTTP_PORT=8080
APP_MANAGEMENT_PORT=8081

# redis 保持原实现；改为 kafka 后使用 Kafka 传输，Redis 仍负责状态、去重与 Outbox。
RESERVATION_QUEUE_BACKEND=redis

# 至少 32 个 UTF-8 字节，生产环境应使用密码生成器产生随机值。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# 可选：三项同时填写后，dev 环境启动时会幂等创建演示管理员。
# 不要把真实管理员密码提交到仓库。
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

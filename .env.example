# 复制为 .env 后再填写；.env 已被 Git 忽略，不能提交真实密码。
POSTGRES_DB=reservationdb
POSTGRES_USER=azki
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 至少 32 个 UTF-8 字节，生产环境应使用密码生成器产生随机值。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# 可选：三项同时填写后，dev 环境启动时会幂等创建演示管理员。
# 不要把真实管理员密码提交到仓库。
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- 先创建资源表，再为历史时段补齐一个默认资源，最后收紧外键为非空。 -->
    <changeSet id="4-introduce-resource-domain" author="Hu">
        <createTable tableName="resource">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="TIMESTAMP"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column defaultValueNumeric="0" name="version" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addColumn tableName="available_slot">
            <column name="resource_id" type="BIGINT"/>
        </addColumn>

        <sql>
            INSERT INTO resource (name, type, location, status, capacity, description, created_by, created_date, version)
            VALUES ('默认实验室资源', 'LAB', '未指定', 'ACTIVE', 1,
                    'V2 迁移为已有时段创建的默认资源', 'system', CURRENT_TIMESTAMP, 0);

            UPDATE available_slot
            SET resource_id = (SELECT id FROM resource WHERE name = '默认实验室资源')
            WHERE resource_id IS NULL;
        </sql>

        <addNotNullConstraint tableName="available_slot" columnName="resource_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="available_slot"
                                 baseColumnNames="resource_id"
                                 constraintName="fk_available_slot_resource"
                                 referencedTableName="resource"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <createIndex tableName="available_slot" indexName="idx_available_slot_resource_start">
            <column name="resource_id"/>
            <column name="start_time"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

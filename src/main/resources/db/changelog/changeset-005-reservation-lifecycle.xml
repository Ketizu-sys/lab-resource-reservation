<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- 引入预约生命周期：取消和完成都保留历史记录，不再通过删除表示状态。 -->
    <changeSet id="5-reservation-lifecycle" author="Hu">
        <addColumn tableName="reservation">
            <column name="status" type="VARCHAR(32)" defaultValue="ACTIVE"/>
            <column name="cancelled_at" type="DATETIME(6)"/>
            <column name="completed_at" type="DATETIME(6)"/>
            <column name="cancel_reason" type="VARCHAR(500)"/>
        </addColumn>

        <!-- 迁移时已经结束的旧预约直接归档为完成，其余旧记录保持有效。 -->
        <sql>
            UPDATE reservation r
            JOIN available_slot s ON r.available_slot_id = s.id
            SET r.status = 'COMPLETED', r.completed_at = UTC_TIMESTAMP(6)
            WHERE s.end_time &lt; CONVERT_TZ(UTC_TIMESTAMP(), '+00:00', '+08:00');
        </sql>

        <addNotNullConstraint tableName="reservation" columnName="status" columnDataType="VARCHAR(32)"/>

        <!--
          InnoDB 要求外键列始终有可用索引；旧唯一索引可能被选作外键支撑索引，
          因此必须先建立生命周期查询/历史关联所需的普通索引，再移除唯一性。
        -->
        <createIndex tableName="reservation" indexName="idx_reservation_user_status">
            <column name="user_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="reservation" indexName="idx_reservation_slot_history">
            <column name="available_slot_id"/>
        </createIndex>

        <!-- 生命周期引入后，用户可拥有多个互不重叠的预约，时段也可保留多条历史记录。 -->
        <dropUniqueConstraint tableName="reservation" constraintName="uk_reservation_active_user"/>

        <dropUniqueConstraint tableName="reservation" constraintName="uk_reservation_slot_initial"/>

        <sql>
            ALTER TABLE reservation
            ADD CONSTRAINT chk_reservation_status
            CHECK (status IN ('ACTIVE', 'CANCELLED', 'COMPLETED'));
        </sql>

        <!--
          MySQL 不支持 PostgreSQL 的部分唯一索引。生成列仅在 ACTIVE 时投影 slot id，
          其他状态为 NULL；MySQL 唯一索引允许多个 NULL，因此完整保留原约束语义。
        -->
        <sql>
            ALTER TABLE reservation
            ADD COLUMN active_slot_id BIGINT
                GENERATED ALWAYS AS (
                    CASE WHEN status = 'ACTIVE' THEN available_slot_id ELSE NULL END
                ) STORED,
            ADD CONSTRAINT uk_reservation_active_slot UNIQUE (active_slot_id);
        </sql>

        <createIndex tableName="reservation" indexName="idx_reservation_status_id_slot">
            <column name="status"/>
            <column name="id"/>
            <column name="available_slot_id"/>
        </createIndex>
        <createIndex tableName="available_slot" indexName="idx_available_slot_end_id">
            <column name="end_time"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

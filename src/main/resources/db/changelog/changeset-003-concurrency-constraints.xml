<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- 数据库作为并发预约的最终防线；当前模型只保留有效预约，因此 user_id 可唯一。 -->
    <changeSet id="3-reservation-concurrency-constraints" author="Hu">
        <addUniqueConstraint
                tableName="reservation"
                columnNames="user_id"
                constraintName="uk_reservation_active_user"/>

        <!-- MySQL 不支持部分索引；把等值过滤列放在范围列之前，供最近空闲时段查询使用。 -->
        <createIndex tableName="available_slot" indexName="idx_available_slot_unreserved_start">
            <column name="is_reserved"/>
            <column name="start_time"/>
            <column name="id"/>
        </createIndex>

        <sql>
            ALTER TABLE available_slot
            ADD CONSTRAINT chk_available_slot_time_order
            CHECK (end_time &gt; start_time);
        </sql>
    </changeSet>

</databaseChangeLog>
